{
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @workspace/janeiro-tour run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://travel-booker-pro.replit.app/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://travel-booker-pro.replit.app/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
